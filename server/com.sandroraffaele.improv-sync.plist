<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sandroraffaele.improv-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>__HOME__/improv-sync/improv-sync.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>IMPROV_SYNC_PORT</key>
    <string>8787</string>
    <key>IMPROV_SYNC_DIR</key>
    <string>__HOME__/.improv-all-in-one</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__HOME__/improv-sync</string>
  <key>StandardOutPath</key>
  <string>__HOME__/improv-sync/improv-sync.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/improv-sync/improv-sync.log</string>
</dict>
</plist>
